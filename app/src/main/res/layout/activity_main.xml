<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient"
    tools:context=".MainActivity">

    <!-- Logo -->
    <ImageView
        android:id="@+id/logo"
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:layout_marginTop="25dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.494"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/logo" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/constraintLayout"
        android:layout_width="320dp"
        android:layout_height="420dp"
        android:background="@drawable/panel_main_menu"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/logo">

        <Button
            android:id="@+id/buttonPlay"
            android:layout_width="240dp"
            android:layout_height="60dp"
            android:layout_marginTop="50dp"
            android:backgroundTint="#0E2978"
            android:fontFamily="sans-serif-smallcaps"
            android:elevation="30dp"
            android:text="Jugar partida"
            android:textAlignment="viewStart"
            android:textSize="20sp"
            android:textStyle="bold"
            app:cornerRadius="14dp"
            app:icon="@drawable/play_icon"
            app:iconPadding="8dp"
            app:iconSize="22dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <Button
            android:id="@+id/buttonCloseApp"
            android:layout_width="240dp"
            android:layout_height="60dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="#780E0E"
            android:fontFamily="sans-serif-smallcaps"
            android:text="Salir del juego"
            android:textAlignment="viewStart"
            android:textSize="20sp"
            android:textStyle="bold"
            app:cornerRadius="14dp"
            app:icon="@drawable/close_icon"
            app:iconPadding="8dp"
            app:iconSize="26dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/buttonPlay" />

    </androidx.constraintlayout.widget.ConstraintLayout>


</androidx.constraintlayout.widget.ConstraintLayout>